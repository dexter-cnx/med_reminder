#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

paths=(
  lib
  test
  tool
  assets/translations.csv
  assets/translations
  lib/l10n/generated_locales.dart
)

printf '\n[pre-push] Preparing generated files and Dart formatting...\n'
before="$(git status --porcelain=v1 -- "${paths[@]}")"

make pre-push-prepare

after="$(git status --porcelain=v1 -- "${paths[@]}")"
if [[ "$before" != "$after" ]]; then
  cat <<'EOF'

[pre-push] Formatter or localization generation changed files.
Review and commit those changes before pushing, then run git push again.
EOF
  git status --short -- "${paths[@]}"
  exit 1
fi

printf '[pre-push] Generated/format state is unchanged. Running CI-equivalent checks...\n'
make check

printf '[pre-push] All checks passed.\n'
